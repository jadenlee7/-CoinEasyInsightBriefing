<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  /* ---------- CoinEasy 2026 tokens ---------- */
  :root{
    --cream:#FFF8F0;        /* brand background */
    --ink:#1B1B23;          /* text ink */
    --ink-soft:#5A5147;
    --orange:#F7931A;       /* Hope */
    --orange-deep:#FB5100;  /* accent */
    --orange-tint:#FFE9D2;
    --card:#FFFFFF;
    --line:#EADFCF;
    --up:#1FA05A;
    --down:#E0442E;
  }
  @font-face{font-family:'Gmarket';src:url('{{ assets }}/fonts/GmarketSansTTFLight.ttf');font-weight:300;}
  @font-face{font-family:'Gmarket';src:url('{{ assets }}/fonts/GmarketSansTTFMedium.ttf');font-weight:500;}
  @font-face{font-family:'Gmarket';src:url('{{ assets }}/fonts/GmarketSansTTFBold.ttf');font-weight:700;}
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{width:{{ card_w|default(1600) }}px;height:{{ card_h|default(900) }}px;overflow:hidden;}
  body{
    font-family:'Gmarket',sans-serif;color:var(--ink);
    background:
      radial-gradient(1200px 700px at 88% -10%, var(--orange-tint) 0%, rgba(255,233,210,0) 55%),
      var(--cream);
    position:relative;
  }
  /* dotted texture */
  .dots{position:absolute;inset:0;
    background-image:radial-gradient(rgba(27,27,35,.06) 1.6px, transparent 1.6px);
    background-size:34px 34px;opacity:.55;}
  /* giant watermark glyph */
  .watermark{position:absolute;right:-40px;top:96px;font-weight:700;font-size:560px;line-height:1;
    color:var(--orange);opacity:.09;letter-spacing:-20px;}
  .wrap{position:relative;height:100%;padding:60px 72px 48px;display:flex;flex-direction:column;}

  /* ---------- header ---------- */
  .head{display:flex;align-items:center;justify-content:space-between;}
  .lockup{display:flex;align-items:center;gap:20px;}
  .lockup img.sym{height:72px;}
  .lockup img.word{height:48px;}
  .head-right{display:flex;align-items:center;gap:14px;}
  .badge{display:flex;align-items:center;gap:12px;background:var(--ink);color:#fff;
    border-radius:999px;padding:12px 26px 12px 14px;font-weight:700;font-size:24px;letter-spacing:2px;}
  .flag{height:34px;width:auto;display:block;}
  .datechip{background:#fff;border:2px solid var(--line);border-radius:999px;
    padding:12px 22px;font-weight:500;font-size:22px;color:var(--ink-soft);}

  /* ---------- hero ---------- */
  .hero{margin-top:64px;}
  .kicker{display:inline-flex;align-items:center;gap:14px;font-weight:700;font-size:26px;
    letter-spacing:6px;color:var(--orange-deep);}
  .kicker:before{content:'';width:46px;height:6px;background:var(--orange);border-radius:3px;}
  .big{font-weight:700;line-height:.98;letter-spacing:-2px;margin-top:18px;}
  .big .num{font-size:{{ hero_size|default(198) }}px;}
  .big .unit{font-size:92px;letter-spacing:0;}
  .pill{display:inline-block;vertical-align:52px;margin-left:26px;border-radius:16px;
    padding:14px 26px;font-size:34px;font-weight:700;color:#fff;letter-spacing:2px;}
  .pill.down{background:var(--down);} .pill.up{background:var(--up);} .pill.flat{background:var(--ink-soft);}
  .insight{margin-top:17px;font-weight:500;font-size:34px;line-height:1.42;color:var(--ink);max-width:1000px;}
  .insight b{color:var(--orange-deep);font-weight:700;}

  /* ---------- stats ---------- */
  .stats{margin-top:auto;display:flex;gap:22px;}
  .stat{background:var(--card);border:2px solid var(--line);border-radius:22px;
    padding:24px 30px;min-width:250px;box-shadow:0 6px 0 rgba(27,27,35,.05);}
  .stat .l{font-size:20px;font-weight:500;letter-spacing:2px;color:var(--ink-soft);}
  .stat .v{margin-top:10px;font-size:40px;font-weight:700;letter-spacing:-1px;}
  .stat .d{margin-top:6px;font-size:20px;font-weight:500;}
  .d.up{color:var(--up);} .d.down{color:var(--down);} .d.flat{color:var(--ink-soft);}

  /* ---------- movers table (daily) ---------- */
  .movers{margin-top:36px;display:flex;flex-direction:column;gap:13px;max-width:945px;}
  .mrow{display:flex;align-items:center;gap:20px;background:var(--card);
    border:2px solid var(--line);border-radius:18px;padding:16px 24px;}
  .mrow .rank{width:44px;height:44px;border-radius:12px;background:var(--orange-tint);
    color:var(--orange-deep);font-weight:700;font-size:24px;display:flex;align-items:center;justify-content:center;}
  .mrow .tick{font-weight:700;font-size:30px;width:150px;}
  .mrow .nm{font-weight:500;font-size:24px;color:var(--ink-soft);flex:1;}
  .mrow .chg{font-weight:700;font-size:30px;width:170px;text-align:right;}
  .mrow .vol{font-weight:500;font-size:21px;color:var(--ink-soft);width:185px;text-align:right;}
  .chg.up{color:var(--up);} .chg.down{color:var(--down);}

  /* ---------- listing ---------- */
  .listing{margin-top:46px;display:flex;align-items:center;gap:34px;}
  .coinbox{background:var(--ink);color:#fff;border-radius:28px;padding:38px 48px;}
  .coinbox .t{font-weight:700;font-size:86px;letter-spacing:-1px;}
  .coinbox .n{margin-top:8px;font-weight:500;font-size:30px;color:#D8D3CC;}
  .exch{display:flex;flex-direction:column;gap:14px;}
  .extag{background:var(--orange);color:#fff;border-radius:999px;padding:14px 30px;
    font-weight:700;font-size:30px;letter-spacing:1px;}
  .extag.sub{background:#fff;color:var(--ink);border:2px solid var(--line);}

  /* ---------- mascot & footer ---------- */
  .mascot{position:absolute;right:88px;bottom:150px;height:{{ mascot_h|default(330) }}px;
    filter:drop-shadow(0 18px 22px rgba(251,81,0,.18));}
  .mascot-tag{position:absolute;right:70px;bottom:118px;background:#fff;border:2px solid var(--line);
    border-radius:999px;padding:8px 20px;font-weight:700;font-size:19px;color:var(--orange-deep);letter-spacing:2px;}
  .foot{margin-top:34px;border-top:2px solid var(--line);padding-top:26px;
    display:flex;justify-content:flex-end;align-items:center;
    font-weight:500;font-size:23px;color:var(--ink-soft);letter-spacing:1px;}
  .foot b{color:var(--ink);font-weight:700;}
  .foot .dot{color:var(--orange);margin:0 10px;}

  /* ---------- analysis (portrait insight card) ---------- */
  .an-h{margin-top:30px;font-weight:700;font-size:58px;line-height:1.16;letter-spacing:-1px;}
  .an-h .l2{color:var(--orange-deep);}
  .duo{display:flex;gap:18px;margin-top:34px;}
  .panel{background:#fff;border:2px solid var(--line);border-radius:22px;padding:24px 26px;flex:1;}
  .panel .pl{font-size:19px;letter-spacing:2px;color:var(--ink-soft);font-weight:500;}
  .gaugerow{display:flex;align-items:center;gap:20px;margin-top:12px;}
  .gval{font-size:54px;font-weight:700;line-height:1;}
  .gtag{display:inline-block;margin-top:8px;background:var(--orange-tint);color:var(--orange-deep);
    border-radius:999px;padding:5px 16px;font-size:19px;font-weight:700;}
  .bars{display:flex;align-items:flex-end;gap:6px;height:60px;margin-top:16px;}
  .bars i{width:15px;background:var(--orange);border-radius:4px;opacity:.9;}
  .flowtxt{font-size:38px;font-weight:700;margin-top:10px;}
  .flowtxt .chip{display:inline-block;vertical-align:8px;margin-left:10px;border:2px solid var(--orange);
    color:var(--orange-deep);border-radius:999px;padding:3px 14px;font-size:19px;font-weight:700;}
  .metric{display:flex;align-items:center;gap:24px;background:#fff;border:2px solid var(--line);
    border-radius:22px;padding:22px 26px;margin-top:18px;}
  .metric .mt{font-size:19px;letter-spacing:1px;color:var(--ink-soft);font-weight:500;}
  .metric .mt b{color:var(--orange-deep);}
  .metric .mv{font-size:33px;font-weight:700;margin-top:6px;}
  .metric .ms{font-size:20px;color:var(--ink-soft);margin-top:6px;font-weight:500;}
  .ibox{margin-top:18px;background:#FFF3E4;border-left:8px solid var(--orange);
    border-radius:16px;padding:20px 24px;}
  .ibox .il{font-size:18px;letter-spacing:2px;font-weight:700;color:var(--orange-deep);}
  .ibox .it{margin-top:8px;font-size:23px;line-height:1.5;font-weight:500;}
  .ibox .it b{font-weight:700;}
  .plan{margin-top:18px;display:flex;flex-direction:column;gap:10px;}
  .prow{display:flex;gap:14px;align-items:flex-start;background:#fff;border:2px solid var(--line);
    border-radius:14px;padding:14px 18px;font-size:22px;font-weight:500;line-height:1.4;}
  .prow b{font-weight:700;}
  .pnum{width:34px;height:34px;border-radius:9px;background:var(--orange);color:#fff;font-weight:700;
    font-size:19px;display:flex;align-items:center;justify-content:center;flex:none;margin-top:1px;}
  .banner{position:relative;margin-top:auto;background:linear-gradient(90deg,var(--orange-deep),var(--orange));
    color:#fff;border-radius:18px;padding:22px 26px;text-align:center;font-weight:700;font-size:29px;letter-spacing:1px;}

  /* ---------- digest (portrait daily digest card) ---------- */
  .dg-hero{position:relative;text-align:center;margin-top:38px;}
  .dg-big{font-weight:700;line-height:1;letter-spacing:-2px;margin-top:14px;}
  .dg-big .num{font-size:96px;}
  .dg-sub{margin-top:12px;font-size:22px;color:var(--ink-soft);font-weight:500;}
  .dg-mascot{position:absolute;top:112px;height:170px;
    filter:drop-shadow(0 12px 16px rgba(251,81,0,.15));}
  .dg-mascot.bull{left:0;} .dg-mascot.bear{right:0;}
  .dg-stats .stat{min-width:0;flex:1;padding:20px 22px;}
  .dg-stats .stat .v{font-size:30px;}
  .dg-note{margin-top:10px;font-size:19px;color:var(--ink-soft);font-weight:500;}
  .dg-cols{display:flex;gap:18px;margin-top:auto;}
  .dg-col{flex:1;display:flex;flex-direction:column;gap:12px;min-width:0;}
  .dg-col .sec{font-size:19px;letter-spacing:2px;color:var(--ink-soft);font-weight:700;margin:4px 0 2px 4px;}
  .dg-row{display:flex;align-items:center;gap:12px;background:var(--card);
    border:2px solid var(--line);border-radius:14px;padding:15px 16px;}
  .dg-row .rank{width:34px;height:34px;border-radius:9px;background:var(--orange-tint);
    color:var(--orange-deep);font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;flex:none;}
  .dg-row .tick{font-weight:700;font-size:21px;white-space:nowrap;max-width:230px;overflow:hidden;text-overflow:ellipsis;}
  .dg-row .nm{font-weight:500;font-size:17px;color:var(--ink-soft);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .dg-row .chg{font-weight:700;font-size:20px;white-space:nowrap;margin-left:auto;}
</style>
</head>
<body>
  <div class="dots"></div>
  <div class="watermark">{{ watermark|default('₩') }}</div>
  <div class="wrap">

    <div class="head">
      <div class="lockup">
        <img class="word" src="{{ assets }}/brand/logo_wordmark.png">
      </div>
      <div class="head-right">
        <div class="badge">{% if badge_flag|default(true) %}<img class="flag" src="{{ assets }}/brand/flag_kr.png">{% endif %}{{ series|default('KOREA INSIGHTS') }}</div>
        <div class="datechip">{{ date_label }}</div>
      </div>
    </div>

    {% if card_type == 'kimchi' %}
    <div class="hero">
      <div class="kicker">{{ kicker }}</div>
      <div class="big" style="margin-left:-9px;"><span class="num">{{ hero_value }}</span><span class="unit">{{ hero_unit }}</span>
        <span class="pill {{ hero_state }}">{{ hero_tag }}</span></div>
      <div class="insight">{{ insight|safe }}</div>
    </div>
    <div class="stats">
      {% for s in stats %}
      <div class="stat"><div class="l">{{ s.label }}</div><div class="v">{{ s.value }}</div>
        {% if s.delta %}<div class="d {{ s.state|default('flat') }}">{{ s.delta }}</div>{% endif %}</div>
      {% endfor %}
    </div>

    {% elif card_type == 'daily' %}
    <div class="hero" style="margin-top:48px;">
      <div class="kicker">{{ kicker }}</div>
      <div class="big" style="margin-top:14px;"><span class="num" style="font-size:84px;letter-spacing:-1px;">{{ headline }}</span></div>
    </div>
    <div class="movers">
      {% for m in movers %}
      <div class="mrow"><div class="rank">{{ loop.index }}</div><div class="tick">{{ m.ticker }}</div>
        <div class="nm">{{ m.name }}</div>
        <div class="chg {{ m.state }}">{{ m.chg }}</div><div class="vol">{{ m.vol }}</div></div>
      {% endfor %}
    </div>
    <div class="stats" style="margin-top:auto;">
      {% for s in stats %}
      <div class="stat"><div class="l">{{ s.label }}</div><div class="v">{{ s.value }}</div>
        {% if s.delta %}<div class="d {{ s.state|default('flat') }}">{{ s.delta }}</div>{% endif %}</div>
      {% endfor %}
    </div>

    {% elif card_type == 'listing' %}
    <div class="hero" style="margin-top:52px;">
      <div class="kicker">{{ kicker }}</div>
      <div class="big" style="margin-top:16px;"><span class="num" style="font-size:96px;">{{ headline }}</span></div>
      <div class="listing">
        <div class="coinbox"><div class="t">{{ coin_ticker }}</div><div class="n">{{ coin_name }}</div></div>
        <div class="exch">
          <div class="extag">{{ exchange }}</div>
          {% if market %}<div class="extag sub">{{ market }}</div>{% endif %}
        </div>
      </div>
      <div class="insight" style="margin-top:34px;">{{ insight|safe }}</div>
    </div>
    <div class="stats" style="margin-top:auto;">
      {% for s in stats %}
      <div class="stat"><div class="l">{{ s.label }}</div><div class="v">{{ s.value }}</div>
        {% if s.delta %}<div class="d {{ s.state|default('flat') }}">{{ s.delta }}</div>{% endif %}</div>
      {% endfor %}
    </div>
    {% elif card_type == 'analysis' %}
    <div class="an-h">{{ headline_l1 }}<br><span class="l2">{{ headline_l2 }}</span></div>
    <div class="duo">
      <div class="panel">
        <div class="pl">FEAR &amp; GREED</div>
        <div class="gaugerow">
          <svg width="150" height="92" viewBox="0 0 150 92">
            <defs><linearGradient id="gg" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#E0442E"/><stop offset=".5" stop-color="#F7931A"/>
              <stop offset="1" stop-color="#1FA05A"/></linearGradient></defs>
            <path d="M15 80 A60 60 0 0 1 135 80" stroke="url(#gg)" stroke-width="15" fill="none" stroke-linecap="round"/>
            <line x1="75" y1="80" x2="{{ fng_x2 }}" y2="{{ fng_y2 }}" stroke="#1B1B23" stroke-width="5" stroke-linecap="round"/>
            <circle cx="75" cy="80" r="7" fill="#1B1B23"/>
          </svg>
          <div><div class="gval">{{ fng_value }}</div><div class="gtag">{{ fng_label }}</div></div>
        </div>
      </div>
      <div class="panel">
        <div class="pl">시장 흐름</div>
        <div class="flowtxt">{{ flow_range }}<span class="chip">{{ flow_label }}</span></div>
        <div class="bars">{% for h in flow_bars %}<i style="height:{{ h }}px"></i>{% endfor %}</div>
      </div>
    </div>
    {% if metric_title %}<div class="metric">
      <svg width="118" height="118" viewBox="0 0 118 118">
        <circle cx="59" cy="59" r="47" stroke="#F1E7D8" stroke-width="15" fill="none"/>
        <circle cx="59" cy="59" r="47" stroke="#1FA05A" stroke-width="15" fill="none"
          stroke-dasharray="{{ donut_dash }}" transform="rotate(-90 59 59)" stroke-linecap="round"/>
        <text x="59" y="55" text-anchor="middle" font-family="Gmarket" font-weight="700" font-size="21" fill="#1B1B23">{{ donut_value }}</text>
        <text x="59" y="76" text-anchor="middle" font-family="Gmarket" font-weight="500" font-size="13" fill="#5A5147">{{ donut_sub }}</text>
      </svg>
      <div><div class="mt">● <b>{{ metric_source }}</b></div>
        <div class="mv">{{ metric_title }}</div>
        <div class="ms">{{ metric_sub }}</div></div>
    </div>{% endif %}
    <div class="ibox"><div class="il">코인이지 인사이트</div><div class="it">{{ insight|safe }}</div></div>
    <div class="plan">
      {% for p in plan %}<div class="prow"><div class="pnum">{{ loop.index }}</div><div>{{ p|safe }}</div></div>{% endfor %}
    </div>
    <div class="banner">{{ banner }}</div>

    {% elif card_type == 'digest' %}
    <img class="dg-mascot bull" src="{{ assets }}/brand/easyboy_bull.png">
    <img class="dg-mascot bear" src="{{ assets }}/brand/easyboy_bear.png">
    <div class="dg-hero">
      <div class="kicker">{{ kicker }}</div>
      <div class="dg-big"><span class="num">{{ hero_value }}</span><span class="pill {{ hero_state }}" style="vertical-align:24px;">{{ hero_tag }}</span></div>
      {% if hero_sub %}<div class="dg-sub">{{ hero_sub }}</div>{% endif %}
    </div>
    <div class="stats dg-stats" style="margin-top:42px;">
      {% for s in stats %}
      <div class="stat"><div class="l">{{ s.label }}</div><div class="v">{{ s.value }}</div>
        {% if s.delta %}<div class="d {{ s.state|default('flat') }}">{{ s.delta }}</div>{% endif %}</div>
      {% endfor %}
    </div>
    <div class="duo" style="margin-top:42px;">
      <div class="panel">
        <div class="pl">{{ kimchi_label }}</div>
        <div class="gaugerow">
          <div><div class="gval">{{ kimchi_value }}</div><div class="gtag">{{ kimchi_tag }}</div></div>
        </div>
        {% if kimchi_sub %}<div class="dg-note">{{ kimchi_sub }}</div>{% endif %}
      </div>
      <div class="panel">
        <div class="pl">{{ fng_title }}</div>
        <div class="gaugerow">
          <svg width="150" height="92" viewBox="0 0 150 92">
            <defs><linearGradient id="dgg" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#E0442E"/><stop offset=".5" stop-color="#F7931A"/>
              <stop offset="1" stop-color="#1FA05A"/></linearGradient></defs>
            <path d="M15 80 A60 60 0 0 1 135 80" stroke="url(#dgg)" stroke-width="15" fill="none" stroke-linecap="round"/>
            <line x1="75" y1="80" x2="{{ fng_x2 }}" y2="{{ fng_y2 }}" stroke="#1B1B23" stroke-width="5" stroke-linecap="round"/>
            <circle cx="75" cy="80" r="7" fill="#1B1B23"/>
          </svg>
          <div><div class="gval">{{ fng_value }}</div><div class="gtag">{{ fng_label }}</div></div>
        </div>
      </div>
    </div>
    <div class="dg-cols">
      <div class="dg-col"><div class="sec">{{ defi_label }}</div>
        {% for m in defi_rows %}
        <div class="dg-row"><div class="rank">{{ loop.index }}</div><div class="tick">{{ m.name }}</div>
          <div class="nm">{{ m.sub }}</div><div class="chg {{ m.state|default('flat') }}">{{ m.chg }}</div></div>
        {% endfor %}
      </div>
      <div class="dg-col"><div class="sec">{{ trend_label }}</div>
        {% for m in trend_rows %}
        <div class="dg-row"><div class="rank">{{ loop.index }}</div><div class="tick">{{ m.name }}</div>
          <div class="nm">{{ m.sub }}</div><div class="chg {{ m.state|default('flat') }}">{{ m.chg }}</div></div>
        {% endfor %}
      </div>
    </div>
    <div class="ibox" style="margin-top:auto;"><div class="il">{{ quote_label }}</div>
      <div class="it">{{ quote_text }}{% if quote_author %} <b>· {{ quote_author }}</b>{% endif %}</div></div>
    {% endif %}

    {% if mascot %}<img class="mascot" src="{{ assets }}/brand/{{ mascot }}.png">{% endif %}
    {% if mascot_tag %}<div class="mascot-tag">{{ mascot_tag }}</div>{% endif %}

    <div class="foot">
      <div><b>@Coiniseasy</b></div>
    </div>
  </div>
</body>
</html>
